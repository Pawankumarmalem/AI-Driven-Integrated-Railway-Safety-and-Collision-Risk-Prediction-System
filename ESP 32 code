
#include <WiFi.h>
#include <HTTPClient.h>
#include <WiFiClientSecure.h>
#include <Wire.h>
#include <WebServer.h>
#include <ArduinoJson.h>

// ============== CONFIGURATION ==============
// Fill these in locally. Never commit credentials to GitHub.
const char* WIFI_SSID = "YOUR_WIFI_NAME";
const char* WIFI_PASSWORD = "YOUR_WIFI_PASSWORD";

const char* API_URL =
  "https://railguard-signal-watch.lovable.app/api/public/sensor-readings";

const char* DEVICE_KEY = "YOUR_NEW_DEVICE_KEY";
const char* DEVICE_ID = "railway-esp32-01";

// ============== PIN CONFIGURATION ==============
const int TRIG_PIN = 5;
const int ECHO_PIN = 18;  // Use voltage divider
const int IR_PIN = 19;

const int GREEN_LED = 27;
const int YELLOW_LED = 14;
const int RED_LED = 25;
const int BUZZER_PIN = 26;
const int BUZZER_CHANNEL = 0;

const int SDA_PIN = 21;
const int SCL_PIN = 22;
const uint8_t MPU_ADDR = 0x68;

// ============== TIMERS ==============
const unsigned long UPLOAD_INTERVAL = 3000;
const unsigned long AI_TIMEOUT = 5000;

unsigned long lastUpload = 0;
unsigned long lastPrint = 0;
unsigned long lastAIUpdate = 0;

// ============== SENSOR DATA ==============
bool distanceValid = false;
bool mpuOK = false;

float distanceCM = 0;
float ax = 0, ay = 0, az = 0;
float gx = 0, gy = 0, gz = 0;

int irValue = HIGH;

// ============== AI DATA ==============
bool aiDetected = false;
String aiClass = "none";
float aiConfidence = 0;
int aiCount = 0;
bool aiDataFresh = false;

String alertLevel = "UNKNOWN";

WebServer server(80);

// ============== MPU HELPERS ==============
bool readMPURegisters(uint8_t reg, uint8_t* buffer,
                      size_t length) {
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(reg);

  if (Wire.endTransmission(false) != 0) return false;

  uint8_t received = Wire.requestFrom(
    (uint8_t)MPU_ADDR,
    (uint8_t)length,
    (uint8_t)true
  );

  if (received != length) {
    while (Wire.available()) Wire.read();
    return false;
  }

  for (size_t i = 0; i < length; i++) {
    buffer[i] = Wire.read();
  }
  return true;
}

bool writeMPURegister(uint8_t reg, uint8_t value) {
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(reg);
  Wire.write(value);
  return Wire.endTransmission() == 0;
}

int16_t combineBytes(uint8_t highByte, uint8_t lowByte) {
  return (int16_t)(((uint16_t)highByte << 8) | lowByte);
}

bool initializeMPU() {
  Wire.begin(SDA_PIN, SCL_PIN);
  Wire.setClock(100000);
  delay(100);

  uint8_t identity = 0;

  if (!readMPURegisters(0x75, &identity, 1)) {
    Serial.println("MPU communication failed");
    return false;
  }

  Serial.printf("MPU WHO_AM_I: 0x%02X\n", identity);

  if (identity != 0x70) return false;

  writeMPURegister(0x6B, 0x00);
  delay(100);
  writeMPURegister(0x1C, 0x00);
  writeMPURegister(0x1B, 0x00);

  Serial.println("MPU initialized");
  return true;
}

bool readMPU() {
  uint8_t data[14];

  if (!readMPURegisters(0x3B, data, sizeof(data))) {
    mpuOK = false;
    return false;
  }

  ax = combineBytes(data[0], data[1]) / 16384.0;
  ay = combineBytes(data[2], data[3]) / 16384.0;
  az = combineBytes(data[4], data[5]) / 16384.0;

  gx = combineBytes(data[8], data[9]) / 131.0;
  gy = combineBytes(data[10], data[11]) / 131.0;
  gz = combineBytes(data[12], data[13]) / 131.0;

  mpuOK = true;
  return true;
}

// ============== ULTRASONIC ==============
float readUltrasonic() {
  digitalWrite(TRIG_PIN, LOW);
  delayMicroseconds(3);
  digitalWrite(TRIG_PIN, HIGH);
  delayMicroseconds(10);
  digitalWrite(TRIG_PIN, LOW);

  unsigned long duration = pulseIn(ECHO_PIN, HIGH, 30000UL);

  if (duration == 0) {
    distanceValid = false;
    return -1;
  }

  float cm = duration * 0.0343 / 2.0;

  if (cm < 2 || cm > 400) {
    distanceValid = false;
    return -1;
  }

  distanceValid = true;
  return cm;
}

// ============== AI RECEIVER ==============
void handleAI() {
  if (!server.hasArg("plain")) {
    server.send(400, "application/json",
                "{\"error\":\"Missing JSON body\"}");
    return;
  }

  JsonDocument doc;
  DeserializationError error =
    deserializeJson(doc, server.arg("plain"));

  if (error) {
    server.send(400, "application/json",
                "{\"error\":\"Invalid JSON\"}");
    return;
  }

  aiDetected = doc["detected"] | false;
  aiClass = doc["object_class"] | "none";
  aiConfidence = doc["confidence"] | 0.0;
  aiCount = doc["count"] | 0;

  aiConfidence = constrain(aiConfidence, 0.0, 1.0);
  aiCount = max(0, aiCount);
  lastAIUpdate = millis();
  aiDataFresh = true;

  Serial.printf("AI: %s | %s | %.2f | count=%d\n",
                aiDetected ? "YES" : "NO",
                aiClass.c_str(),
                aiConfidence,
                aiCount);

  server.send(200, "application/json",
              "{\"status\":\"AI data received\"}");
}

void handleHealth() {
  server.send(200, "application/json",
              "{\"status\":\"ESP32 online\"}");
}

void startLocalServer() {
  server.on("/ai", HTTP_POST, handleAI);
  server.on("/health", HTTP_GET, handleHealth);
  server.begin();
  Serial.println("AI receiver server started on port 80");
}

// ============== ALERT LOGIC ==============
bool relevantAIObject() {
  if (!aiDataFresh || !aiDetected || aiConfidence < 0.55) {
    return false;
  }

  return aiClass == "person" ||
         aiClass == "car" ||
         aiClass == "truck" ||
         aiClass == "bus" ||
         aiClass == "motorcycle" ||
         aiClass == "bicycle" ||
         aiClass == "train";
}

void setOutputs(bool green, bool yellow,
                bool red, bool buzzer) {
  digitalWrite(GREEN_LED, green ? HIGH : LOW);
  digitalWrite(YELLOW_LED, yellow ? HIGH : LOW);
  digitalWrite(RED_LED, red ? HIGH : LOW);
  ledcWriteTone(BUZZER_CHANNEL, buzzer ? 2000 : 0);
}

void updateAlert() {
  aiDataFresh =
    (lastAIUpdate != 0 &&
     millis() - lastAIUpdate <= AI_TIMEOUT);

  bool aiRisk = relevantAIObject();

  // Demo-only combined alert rules.
  if (distanceValid && distanceCM <= 20) {
    alertLevel = "CRITICAL";
    setOutputs(false, false, true, true);
  }
  else if (aiRisk ||
           (distanceValid && distanceCM <= 50)) {
    alertLevel = "WARNING";
    setOutputs(false, true, false, true);
  }
  else if (!distanceValid && !aiDataFresh) {
    alertLevel = "UNKNOWN";
    setOutputs(false, true, false, false);
  }
  else {
    alertLevel = "SAFE";
    setOutputs(true, false, false, false);
  }
}

// ============== WIFI ==============
void connectWiFi() {
  if (WiFi.status() == WL_CONNECTED) return;

  WiFi.mode(WIFI_STA);
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);

  Serial.print("Connecting to Wi-Fi...");
  unsigned long start = millis();

  while (WiFi.status() != WL_CONNECTED &&
         millis() - start < 15000) {
    delay(500);
    Serial.print(".");
  }

  Serial.println();

  if (WiFi.status() == WL_CONNECTED) {
    Serial.println("Wi-Fi connected");
    Serial.print("DevKit IP: ");
    Serial.println(WiFi.localIP());
    startLocalServer();
  } else {
    Serial.println("Wi-Fi connection failed");
  }
}

// ============== LOVABLE UPLOAD ==============
void uploadSensorData() {
  if (WiFi.status() != WL_CONNECTED) return;

  JsonDocument doc;

  doc["device_id"] = DEVICE_ID;
  if (distanceValid) doc["distance_cm"] = distanceCM;
  else doc["distance_cm"] = nullptr;

  doc["ir_value"] = irValue;
  doc["mpu_ok"] = mpuOK;

  if (mpuOK) {
    doc["accel_x"] = ax;
    doc["accel_y"] = ay;
    doc["accel_z"] = az;
    doc["gyro_x"] = gx;
    doc["gyro_y"] = gy;
    doc["gyro_z"] = gz;
  } else {
    doc["accel_x"] = nullptr;
    doc["accel_y"] = nullptr;
    doc["accel_z"] = nullptr;
    doc["gyro_x"] = nullptr;
    doc["gyro_y"] = nullptr;
    doc["gyro_z"] = nullptr;
  }

  doc["latitude"] = nullptr;
  doc["longitude"] = nullptr;
  doc["gps_valid"] = false;

  doc["ai_detected"] = aiDataFresh && aiDetected;
  doc["ai_object_class"] = aiDataFresh ? aiClass : "none";
  doc["ai_confidence"] = aiDataFresh ? aiConfidence : 0;
  doc["ai_count"] = aiDataFresh ? aiCount : 0;
  doc["ai_status"] = aiDataFresh ? "ACTIVE" : "STALE";

  doc["alert_level"] = alertLevel;

  String json;
  serializeJson(doc, json);

  WiFiClientSecure client;
  // Testing only. Replace with certificate validation for deployment.
  client.setInsecure();

  HTTPClient http;
  http.setConnectTimeout(10000);
  http.setTimeout(10000);

  if (!http.begin(client, API_URL)) {
    Serial.println("HTTP begin failed");
    return;
  }

  http.addHeader("Content-Type", "application/json");
  http.addHeader("x-device-key", DEVICE_KEY);

  Serial.println("Uploading combined data...");
  int code = http.POST(json);

  Serial.printf("Lovable HTTP response: %d\n", code);

  if (code > 0) {
    Serial.println(http.getString());
  } else {
    Serial.println(HTTPClient::errorToString(code));
  }

  http.end();
}

// ============== SETUP ==============
void setup() {
  Serial.begin(115200);
  delay(1500);

  pinMode(TRIG_PIN, OUTPUT);
  pinMode(ECHO_PIN, INPUT);
  pinMode(IR_PIN, INPUT);

  pinMode(GREEN_LED, OUTPUT);
  pinMode(YELLOW_LED, OUTPUT);
  pinMode(RED_LED, OUTPUT);
  pinMode(BUZZER_PIN, OUTPUT);

  ledcSetup(BUZZER_CHANNEL, 2000, 8);
  ledcAttachPin(BUZZER_PIN, BUZZER_CHANNEL);
  ledcWriteTone(BUZZER_CHANNEL, 0);

  Serial.println("\nRAILWAY SAFETY AI DEMO");

  mpuOK = initializeMPU();
  connectWiFi();
}

// ============== MAIN LOOP ==============
void loop() {
  if (WiFi.status() != WL_CONNECTED) {
    connectWiFi();
  }

  server.handleClient();

  float measured = readUltrasonic();
  if (distanceValid) distanceCM = measured;

  irValue = digitalRead(IR_PIN);
  readMPU();

  updateAlert();

  if (millis() - lastPrint >= 1000) {
    lastPrint = millis();

    Serial.println("\n------ SYSTEM STATUS ------");
    if (distanceValid) Serial.printf("Distance: %.2f cm\n", distanceCM);
    else Serial.println("Distance: UNKNOWN");

    Serial.printf("IR: %d\n", irValue);
    Serial.printf("MPU: %s\n", mpuOK ? "OK" : "ERROR");
    Serial.printf("AI: %s (%s, %.2f)\n",
                  aiDataFresh ? "FRESH" : "STALE",
                  aiClass.c_str(), aiConfidence);
    Serial.printf("Alert: %s\n", alertLevel.c_str());
  }

  if (millis() - lastUpload >= UPLOAD_INTERVAL) {
    lastUpload = millis();
    uploadSensorData();
  }

  delay(10);
}
